+            clientAddress: inv.clientAddress || '',
+            clientGSTIN: inv.clientGSTIN || '',
+            amount: String(inv.amount ?? ''),
+            gstRate: String(inv.gstRate ?? '18'),
+            isIntraState: inv.isIntraState === false ? 'false' : 'true',
